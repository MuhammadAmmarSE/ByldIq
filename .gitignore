# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Patterns below are intentionally un-anchored (no leading slash) so they
# match inside every workspace package (apps/*, packages/*, services/*),
# not just the repo root.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings
.claude/settings.local.json

# storybook
storybook-static

# testing
test-results
playwright-report
blob-report
playwright/.cache

# lighthouse
.lighthouseci

# content-collections
.content-collections

*storybook.log
